<Project>
    <PropertyGroup Label="Common Metadata">
        <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
        <LatestRimworldVersion>1.7</LatestRimworldVersion>

        <LangVersion>latest</LangVersion>
        <Configurations>Debug;Debug - 1.4;Debug - 1.5;Debug - 1.6;Debug - 1.7;Release;Release - 1.4;Release - 1.5;Release - 1.6;Release - 1.7</Configurations>
        <Platforms>AnyCPU</Platforms>
        <DebugType>embedded</DebugType>

        <Description>Prepare Procedurally is a mod that enables quick automation to colony and tribal starts in the game Rimworld by Ludeon Studios</Description>
        <Company>Necrofancy</Company>
        <Product>Prepare Procedurally</Product>
        <Copyright>2023 - 2026</Copyright>
        <Version>1.3.0.0</Version>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <DisableImplicitConfigurationDefines>true</DisableImplicitConfigurationDefines>
        
        <RimworldVersion Condition="'$(RimworldVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Match('$(Configuration)', '\d+\.\d+').Value)</RimworldVersion>
        <RimworldVersion Condition="'$(RimworldVersion)' == ''">$(LatestRimworldVersion)</RimworldVersion>
    </PropertyGroup>

    <!--Debug is just inferred based on config-->
    <Choose>
        <When Condition="$(Configuration.StartsWith('Debug'))">
            <PropertyGroup Label="Debug Settings">
                <Optimize>false</Optimize>
            </PropertyGroup>
        </When>
        <Otherwise>
            <PropertyGroup Label="Release Settings">
                <Optimize>true</Optimize>
            </PropertyGroup>
        </Otherwise>
    </Choose>
    
    <PropertyGroup Label="Defining Rimworld Versions for ifdef">
        <DefineConstants>$(DefineConstants);RW$(RimworldVersion.Replace('.', '_'))</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Label="Version Floors">
        <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(RimworldVersion)','1.5'))">$(DefineConstants);RW1_5_OR_GREATER</DefineConstants>
        <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(RimworldVersion)','1.6'))">$(DefineConstants);RW1_6_OR_GREATER;SEARCH_MENU_AVAILABLE</DefineConstants>
        <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(RimworldVersion)','1.7'))">$(DefineConstants);RW1_7_OR_GREATER;WAYLITH</DefineConstants>
        <IsWaylith>$([MSBuild]::VersionGreaterThanOrEquals('$(RimworldVersion)','1.7'))</IsWaylith>
    </PropertyGroup>
    
    <Choose>
        <When Condition="'$(IsWaylith)' == 'true'">
            <PropertyGroup Label="Waylith Properties">
                <TargetFramework>net10.0</TargetFramework>
                <GenerateDependencyFile>false</GenerateDependencyFile>
            </PropertyGroup>
            <ItemGroup Label="Waylith Package References">
                <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" />
            </ItemGroup>
            <ItemGroup Label="Waylith Assembly References">
                <Reference Include="Assembly-CSharp">
                    <HintPath>..\..\Steam\$(RimworldVersion)\Game\Assembly-CSharp.dll</HintPath>
                    <Private>false</Private>
                </Reference>
                <Reference Include="UnityStubs">
                    <HintPath>..\..\Steam\$(RimworldVersion)\Game\UnityStubs.dll</HintPath>
                    <Private>false</Private>
                </Reference>
                <Reference Include="Waylith">
                    <HintPath>..\..\Steam\$(RimworldVersion)\Game\Waylith.dll</HintPath>
                    <Private>false</Private>
                </Reference>
            </ItemGroup>
        </When>
        <Otherwise>
            <PropertyGroup Label="Unity Properties">
                <TargetFramework>net48</TargetFramework>
            </PropertyGroup>
            <ItemGroup Label="Unity Package References">
                <!-- Allows building net48 without relying on machine-installed targeting packs -->
                <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
                <PackageReference Include="Lib.Harmony" Version="2.4.2" />
            </ItemGroup>
            <ItemGroup Label="Unity Assembly References">
                <Reference Include="Assembly-CSharp">
                    <HintPath>..\..\Steam\$(RimworldVersion)\Game\Assembly-CSharp.dll</HintPath>
                    <Private>false</Private>
                </Reference>
                <Reference Include="UnityEngine.CoreModule">
                    <HintPath>..\..\Steam\$(RimworldVersion)\Game\UnityEngine.CoreModule.dll</HintPath>
                    <Private>false</Private>
                </Reference>
                <Reference Include="UnityEngine.IMGUIModule">
                    <HintPath>..\..\Steam\$(RimworldVersion)\Game\UnityEngine.IMGUIModule.dll</HintPath>
                    <Private>false</Private>
                </Reference>
                <Reference Include="UnityEngine.TextRenderingModule">
                    <HintPath>..\..\Steam\$(RimworldVersion)\Game\UnityEngine.TextRenderingModule.dll</HintPath>
                    <Private>false</Private>
                </Reference>
            </ItemGroup>
        </Otherwise>
    </Choose>

    <PropertyGroup Label="Test Project Specific Changes" Condition="$(MSBuildProjectName.EndsWith('.Test'))">
        <!--Test runners typically need copy-local assemblies as well as a dependency file typically-->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <GenerateDependencyFile>true</GenerateDependencyFile>
    </PropertyGroup>
    
    <PropertyGroup Label="Version-Specifying Intermediates">
        <!--OBJ between Unity and Waylith will break horribly if kept the same-->
        <BaseIntermediateOutputPath>obj\$(RimworldVersion)\</BaseIntermediateOutputPath>
        <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
    </PropertyGroup>
</Project>