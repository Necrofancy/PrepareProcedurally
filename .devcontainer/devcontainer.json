{
  "name": "Linux Environment",
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/PrepareProcedurally",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/PrepareProcedurally,type=bind,z",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:1": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "userUid": "1000",
      "userGid": "1000",
      "username": "vscode"
    }
  },
  "remoteUser": "root",
  "containerUser": "vscode"
}