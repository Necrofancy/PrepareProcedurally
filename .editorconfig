# Naming follows RimWorld's public API, which is the only part of Ludeon's style that survives
# compilation. Brace and whitespace layout seen in decompiled RimWorld is ILSpy/dnSpy output,
# so the formatting choices below just codify what this repo already does.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[**.xml]
indent_style = space
indent_size = 4

[*.{csproj,props,targets}]
indent_style = space
indent_size = 4

[*.cs]
indent_style = space
indent_size = 4
charset = utf-8

# layout
csharp_style_namespace_declarations = file_scoped:warning
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = when_multiline:suggestion
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
resharper_csharp_place_simple_embedded_statement_on_same_line = never

# syntax
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = when_on_single_line:suggestion

# styles
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_style.i_pascal.capitalization = pascal_case
dotnet_naming_style.i_pascal.required_prefix = I

# symbol groups
dotnet_naming_symbols.consts.applicable_kinds = field, local
dotnet_naming_symbols.consts.applicable_accessibilities = *
dotnet_naming_symbols.consts.required_modifiers = const

dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

# match what Rimworld does as that's what this workspace has as main reference
dotnet_naming_symbols.fields.applicable_kinds = field
dotnet_naming_symbols.fields.applicable_accessibilities = *

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_symbols.type_and_members.applicable_kinds = namespace, class, struct, enum, delegate, method, local_function, property, event
dotnet_naming_symbols.type_and_members.applicable_accessibilities = *

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter, local
dotnet_naming_symbols.locals_and_parameters.applicable_accessibilities = *

# Other rules
dotnet_naming_rule.consts_are_pascal.symbols = consts
dotnet_naming_rule.consts_are_pascal.style = pascal
dotnet_naming_rule.consts_are_pascal.severity = warning

dotnet_naming_rule.static_readonly_are_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_are_pascal.style = pascal
dotnet_naming_rule.static_readonly_are_pascal.severity = warning

dotnet_naming_rule.fields_are_camel.symbols = fields
dotnet_naming_rule.fields_are_camel.style = camel
dotnet_naming_rule.fields_are_camel.severity = warning

dotnet_naming_rule.interfaces_are_i_pascal.symbols = interfaces
dotnet_naming_rule.interfaces_are_i_pascal.style = i_pascal
dotnet_naming_rule.interfaces_are_i_pascal.severity = warning

dotnet_naming_rule.types_and_members_are_pascal.symbols = type_and_members
dotnet_naming_rule.types_and_members_are_pascal.style = pascal
dotnet_naming_rule.types_and_members_are_pascal.severity = warning

dotnet_naming_rule.locals_and_parameters_are_camel.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_are_camel.style = camel
dotnet_naming_rule.locals_and_parameters_are_camel.severity = warning

# Def syntax needs to be exact
[src/**/Defs/*DefOf.cs]
dotnet_naming_rule.static_readonly_are_pascal.severity = none
dotnet_naming_rule.fields_are_camel.severity = none

# Harmony needs to have their specific names
[src/**/{HarmonyPatches,ReusingVanillaUi*}.cs]
dotnet_naming_rule.locals_and_parameters_are_camel.severity = none

# On the roadmap to be taken out
[src/Necrofancy.PrepareProcedurally/ReusingVanillaUi.1.4.cs]
generated_code = true

[src/Necrofancy.PrepareProcedurally/Interface/MaplessPawnTable.cs]
generated_code = true
